<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Fraqcel.Engine.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions in this machine's package cache, so restore works offline. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.6.0" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fraqcel.Engine\Fraqcel.Engine.csproj" />
    <Reference Include="System.Drawing" />
    <!-- For EDecimal in the wheel-zoom checks; never copied as FraqcelLib.dll (see Directory.Build.targets). -->
    <Reference Include="FraqcelLib">
      <HintPath>$(FraqcelLibDir)$(FraqcelDllName)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
